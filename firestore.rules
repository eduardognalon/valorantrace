rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "SEU_UID_AQUI";
    }
    match /race/{doc}        { allow read: if true; allow write: if isAdmin(); }
    match /evaluations/{id}  { allow read: if true; allow write: if isAdmin(); }
  }
}
